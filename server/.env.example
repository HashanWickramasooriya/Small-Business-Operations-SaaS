NODE_ENV=development
PORT=4000

# Public URL of the frontend, used for CORS.
APP_URL=http://localhost:5173

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/businessos

# Secrets for signing access/refresh tokens. Generate strong random values in production,
# e.g. `openssl rand -hex 32`. Never commit real values.
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
